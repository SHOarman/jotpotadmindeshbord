rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Primitive Helpers
    // ===============================================================
    function isAuthenticated() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }

    function isSuperAdmin() {
      return isAuthenticated() && "email" in request.auth.token && request.auth.token.email != null && (
        request.auth.token.email == 'S.m.Anonto5@gmail.com' ||
        request.auth.token.email == 's.m.anonto5@gmail.com' ||
        request.auth.token.email == 'S.M.Anonto5@gmail.com' ||
        request.auth.token.email == 'smanonto5@gmail.com' ||
        request.auth.token.email == 'Smanonto5@gmail.com'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isAgent() {
      return isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent'
      );
    }

    function isEmployeeSelf(empId) {
      return isAuthenticated() && 
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/employees/$(empId)) && 
             get(/databases/$(database)/documents/employees/$(empId)).data.email == request.auth.token.email;
    }

    function isEmployeeByEmail(emailStr) {
      return isAuthenticated() && 
             request.auth.token.email != null &&
             emailStr == request.auth.token.email;
    }

    function hasPermission(permission) {
      return isAdmin() || (
        isAgent() && 
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          'rules' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rules is string && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rules.matches('.*' + permission + '.*')
        )
      );
    }

    function isRegistrationEnabled() {
      return exists(/databases/$(database)/documents/settings/global) && 
             'registrationEnabled' in get(/databases/$(database)/documents/settings/global).data &&
             get(/databases/$(database)/documents/settings/global).data.registrationEnabled == true;
    }

    // ===============================================================
    // Validation Blueprints
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['admin', 'agent', 'user', 'employee'];
    }

    function isValidDriver(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 20 &&
             data.vehicleType is string && data.vehicleType.size() <= 50 &&
             data.division is string && data.division.size() <= 100 &&
             data.district is string && data.district.size() <= 100;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['name', 'phone', 'role', 'baseSalary', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.role is string && data.role.size() <= 50 &&
             data.baseSalary is number &&
             data.status in ['active', 'inactive'];
    }

    function isValidSalary(data) {
      return data.keys().hasAll(['employeeId', 'amount', 'month', 'status']) &&
             data.employeeId is string && data.employeeId.size() > 0 &&
             data.amount is number &&
             data.month is string && data.month.matches('^[0-9]{4}-[0-9]{2}$') &&
             data.status in ['paid', 'pending', 'cancelled'];
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['employeeId', 'date', 'status']) &&
             data.employeeId is string && data.employeeId.size() > 0 &&
             data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.status in ['present', 'absent', 'half-day', 'leave', 'unmarked'];
    }

    function isValidLeave(data) {
      return data.keys().hasAll(['employeeId', 'startDate', 'endDate', 'reason', 'type', 'status']) &&
             data.employeeId is string && data.employeeId.size() > 0 &&
             data.startDate is string && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.endDate is string && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.reason is string && data.reason.size() <= 500 &&
             data.type in ['sick', 'casual', 'earned', 'unpaid'] &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /{document=**} { 
      allow read, write: if false; 
    }

    match /_test_connection_/{docId} {
      allow read: if true;
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidId(userId) && isValidUser(incoming()) && (
        (isOwner(userId) && incoming().role == 'user') || isAdmin()
      );
      allow update: if isAuthenticated() && (
        (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name']) && incoming().name is string && incoming().name.size() <= 100) || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Drivers
    match /drivers/{driverId} {
      // Public read
      allow read: if true;
      allow create: if isValidId(driverId) && isValidDriver(incoming()) && (
        isAgent() || (isRegistrationEnabled() && incoming().isActive == false)
      );
      // Agents can update fields, admins can update anything
      allow update: if isAgent();
      allow delete: if isAdmin();
    }

    // Locations
    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(locationId);
    }

    // Vehicle Types
    match /vehicleTypes/{typeId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(typeId);
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }
    
    // System Settings (e.g. WhatsApp config)
    match /system_settings/{document=**} {
      allow read, write: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if hasPermission('payments');
      allow create: if isValidId(paymentId) && (
        hasPermission('payments') || (
          incoming().keys().hasAll(['status', 'amount', 'driverId']) &&
          incoming().status == 'pending' &&
          incoming().amount is number &&
          incoming().driverId is string && incoming().driverId.size() <= 100
        )
      );
      allow update: if hasPermission('payments.manage');
      allow delete: if isAdmin();
    }
    
    // Employees and Salaries
    match /employees/{employeeId} {
      allow read: if isAgent() || isEmployeeByEmail(resource.data.email);
      allow create: if isAdmin() && isValidId(employeeId) && isValidEmployee(incoming());
      allow update: if isAdmin() && isValidId(employeeId) && isValidEmployee(incoming());
      allow delete: if isAdmin() && isValidId(employeeId);
    }
    match /salaries/{salaryId} {
      allow read: if isAgent() || isEmployeeSelf(resource.data.employeeId);
      allow create: if isAdmin() && isValidId(salaryId) && isValidSalary(incoming());
      allow update: if isAdmin() && isValidId(salaryId) && isValidSalary(incoming());
      allow delete: if isAdmin() && isValidId(salaryId);
    }
    match /attendance/{attendanceId} {
      allow read: if isAgent() || isEmployeeSelf(resource.data.employeeId);
      allow create: if (isAdmin() || isEmployeeSelf(incoming().employeeId)) && isValidId(attendanceId) && isValidAttendance(incoming());
      allow update: if (isAdmin() || (isEmployeeSelf(resource.data.employeeId) && isEmployeeSelf(incoming().employeeId))) && isValidId(attendanceId) && isValidAttendance(incoming());
      allow delete: if isAdmin() && isValidId(attendanceId);
    }
    match /leaves/{leaveId} {
      allow read: if isAgent() || isEmployeeSelf(resource.data.employeeId);
      allow create: if (isAdmin() || isEmployeeSelf(incoming().employeeId)) && isValidId(leaveId) && isValidLeave(incoming());
      allow update: if isAdmin() && isValidId(leaveId) && isValidLeave(incoming());
      allow delete: if isAdmin() && isValidId(leaveId);
    }
    match /employee_tasks/{taskId} {
      allow read: if isAgent() || isEmployeeSelf(resource.data.employeeId);
      allow create: if (isAdmin() || isEmployeeSelf(incoming().employeeId)) && isValidId(taskId);
      allow update: if isAdmin() && isValidId(taskId);
      allow delete: if isAdmin() && isValidId(taskId);
    }

    // Analytics
    match /analytics_calls/{callId} {
      allow read: if isAgent();
      allow create: if isValidId(callId) && 
                    incoming().keys().hasAll(['driverId']) && 
                    incoming().driverId is string && 
                    incoming().driverId.size() <= 100;
    }
    match /analytics_visits/{visitId} {
      allow read: if isAgent();
      allow create: if isValidId(visitId) && incoming().keys().hasAll(['date', 'count']);
      allow update: if isValidId(visitId) && incoming().diff(existing()).affectedKeys().hasOnly(['count']);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAgent();
      allow create: if isValidId(notificationId) && isAgent() &&
                    incoming().keys().hasAll(['type', 'message']) && 
                    incoming().message is string && 
                    incoming().message.size() <= 500;
      allow update: if isAgent();
      allow delete: if isAdmin();
    }

    // Action Logs
    match /actionLogs/{logId} {
      allow read, create: if isAgent() || isAdmin();
      allow delete: if isAdmin();
    }

    // Support Sessions
    match /support_sessions/{sessionId} {
      allow read: if true;
      allow create: if isValidId(sessionId);
      allow update: if isValidId(sessionId);
      
      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidId(messageId);
        allow update: if isAgent();
        allow delete: if isAdmin();
      }
    }

    // WhatsApp Sessions
    match /whatsapp_sessions/{sessionId} {
      allow read: if isAgent();
      allow create: if isAgent();
      allow update: if isAgent();
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isAgent();
        allow create: if isAgent();
        allow update: if isAgent();
        allow delete: if isAdmin();
      }
    }

    match /quick_replies/{replyId} {
      allow read: if isAgent();
      allow write: if isAgent() && isValidId(replyId);
    }
  }
}
